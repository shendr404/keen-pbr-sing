[Unit]
Description=keen-pbr-sx policy-based routing daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kernel modules for the iptables backend (multiport matching, statistic-based load balancing, connmark); not needed with nftables.
ExecStartPre=-/bin/sh -c 'command -v nft >/dev/null 2>&1 || modprobe -a xt_multiport xt_statistic xt_connmark'
ExecStart=/usr/sbin/keen-pbr-sx --config /etc/keen-pbr-sx/config.json --pid-file /var/run/keen-pbr-sx.pid --log-target syslog service
ExecReload=/bin/kill -HUP $MAINPID
# Runs after every exit, also after kill -9 or a crash: removes firewall rules
# the daemon left behind (a clean stop leaves none; finding any is logged).
ExecStopPost=-/usr/lib/keen-pbr-sx/cleanup-firewall.sh --reason stop
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
