#!/bin/sh
# Never runs keen-pbr-sx itself (a broken binary or config must not block or
# break the removal) and never fails: every step is best effort.

PKG_LIB="${KEEN_PBR_PKG_LIB:-/opt/usr/lib/keen-pbr-sx/pkg.sh}"
_have_pkg=0
# shellcheck disable=SC1090
if [ -f "$PKG_LIB" ]; then
    . "$PKG_LIB"
    _have_pkg=1
fi

echo "Stopping keen-pbr-sx service..."
"${KEEN_PBR_INIT:-/opt/etc/init.d/S80keen-pbr-sx}" stop || true

# Captured before uninstall, which restarts (and may stop) dnsmasq.
[ "$_have_pkg" = 1 ] && record_dnsmasq_state

# Upgrade and `opkg install --force-reinstall` must not unhook dnsmasq.
# opkg passes "upgrade <version>" and Entware sets PKG_UPGRADE=1 on an
# upgrade. A reinstall can look like "remove" while the binary will remain;
# real_removal covers that too.
if [ "$_have_pkg" = 1 ]; then
    real_removal "$@" && _remove=1 || _remove=0
else
    case "${1:-}" in
        upgrade|reinstall) _remove=0 ;;
        *)
            case "${PKG_UPGRADE:-}" in
                1|yes|true) _remove=0 ;;
                *) _remove=1 ;;
            esac
            ;;
    esac
fi

if [ "$_remove" = 1 ]; then
    "${KEEN_PBR_HOOK:-/opt/usr/lib/keen-pbr-sx/dnsmasq-hook.sh}" uninstall >/dev/null 2>&1 || true
    /opt/usr/lib/keen-pbr-sx/interface-forward.sh remove >/dev/null 2>&1 || true
    /opt/usr/lib/keen-pbr-sx/cleanup-firewall.sh >/dev/null 2>&1 || true
fi

exit 0
