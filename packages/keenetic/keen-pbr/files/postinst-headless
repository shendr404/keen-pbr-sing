#!/bin/sh

echo "keen-pbr-headless installation"
echo "--------------------------------"

mkdir -p /opt/usr/lib/keen-pbr 2>/dev/null || true

PKG_LIB="${KEEN_PBR_PKG_LIB:-/opt/usr/lib/keen-pbr/pkg.sh}"
_have_pkg=0
# shellcheck disable=SC1090
if [ -f "$PKG_LIB" ]; then
    . "$PKG_LIB"
    _have_pkg=1
fi

if [ "$PKG_UPGRADE" = "1" ] && ! grep -q '"version"' /opt/etc/keen-pbr/config.json 2>/dev/null; then
    echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
fi

_hook="${KEEN_PBR_HOOK:-/opt/usr/lib/keen-pbr/dnsmasq-hook.sh}"
_dns="${DNSMASQ_INIT:-/opt/etc/init.d/S56dnsmasq}"
if [ -x "$_hook" ] && [ -f "${DNSMASQ_CONF:-/opt/etc/dnsmasq.conf}" ]; then
    "$_hook" reinstall-hook || echo "Failed to restore the dnsmasq hook"
    if [ "$_have_pkg" = 1 ]; then
        dnsmasq_should_restart && _restart_dns=1 || _restart_dns=0
    else
        _restart_dns=1
    fi
    if [ "$_restart_dns" = 1 ] && [ -x "$_dns" ]; then
        "$_dns" restart || echo "Failed to restart dnsmasq"
    fi
    _hint=$("$_hook" port53-hint 2>/dev/null) && printf '%s\n' "$_hint"
fi

echo ""
if [ "$_have_pkg" = 1 ]; then
    start_detached "${KEEN_PBR_INIT:-/opt/etc/init.d/S80keen-pbr}" restart \
        || echo "Failed to start keen-pbr service"
else
    nohup setsid "${KEEN_PBR_INIT:-/opt/etc/init.d/S80keen-pbr}" restart >/dev/null 2>&1 &
fi
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API is unavailable in the headless version. Please use CLI to manage keen-pbr."

exit 0
