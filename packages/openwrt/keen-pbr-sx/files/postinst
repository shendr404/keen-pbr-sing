#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

# One-time copy from the keen-pbr package. A later run must not overwrite a
# config the user already changed. The old procd service is stopped every time.
if [ -d /etc/keen-pbr ] && [ ! -f /etc/keen-pbr-sx/.migrated-from-keen-pbr ]; then
    mkdir -p /etc/keen-pbr-sx
    if [ -f /etc/keen-pbr/config.json ]; then
        _copy=0
        if [ ! -f /etc/keen-pbr-sx/config.json ]; then
            _copy=1
        elif [ -f /etc/keen-pbr-sx/config.example.json ] && cmp -s /etc/keen-pbr-sx/config.json /etc/keen-pbr-sx/config.example.json; then
            _copy=1
        fi
        if [ "$_copy" = 1 ]; then
            sed \
                -e 's#/etc/keen-pbr-sx#@@K@@#g' \
                -e 's#/usr/lib/keen-pbr-sx#@@L@@#g' \
                -e 's#/var/run/keen-pbr-sx#@@R@@#g' \
                -e 's#/var/cache/keen-pbr-sx#@@C@@#g' \
                -e 's#/etc/keen-pbr#/etc/keen-pbr-sx#g' \
                -e 's#/usr/lib/keen-pbr#/usr/lib/keen-pbr-sx#g' \
                -e 's#/usr/sbin/keen-pbr#/usr/sbin/keen-pbr-sx#g' \
                -e 's#/var/run/keen-pbr#/var/run/keen-pbr-sx#g' \
                -e 's#/var/cache/keen-pbr#/var/cache/keen-pbr-sx#g' \
                -e 's#@@K@@#/etc/keen-pbr-sx#g' \
                -e 's#@@L@@#/usr/lib/keen-pbr-sx#g' \
                -e 's#@@R@@#/var/run/keen-pbr-sx#g' \
                -e 's#@@C@@#/var/cache/keen-pbr-sx#g' \
                /etc/keen-pbr/config.json > /etc/keen-pbr-sx/config.json.migrating \
                && mv /etc/keen-pbr-sx/config.json.migrating /etc/keen-pbr-sx/config.json
        fi
    fi
    if [ -f /etc/keen-pbr/sing-box-links.json ] && [ ! -e /etc/keen-pbr-sx/sing-box-links.json ]; then
        cp /etc/keen-pbr/sing-box-links.json /etc/keen-pbr-sx/sing-box-links.json
    fi
    : > /etc/keen-pbr-sx/.migrated-from-keen-pbr
fi
if [ -x /etc/init.d/keen-pbr ]; then
    /etc/init.d/keen-pbr stop >/dev/null 2>&1 || true
    /etc/init.d/keen-pbr disable >/dev/null 2>&1 || true
fi

# opkg does not tell a postinst the old version, so the check is the config:
# a config written by 3.3.x has no "version" field.
KEEN_PBR_CONFIG="/etc/keen-pbr-sx/config.json"
if [ "$PKG_UPGRADE" = "1" ] && [ -f "$KEEN_PBR_CONFIG" ] && ! grep -q '"version"' "$KEEN_PBR_CONFIG"; then
    echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
fi

# Rewrites keen-pbr-sx's dnsmasq entry in /tmp at boot, before dnsmasq starts.
[ -e /etc/rc.d/S18keen-pbr-sx-dnsmasq ] || /etc/init.d/keen-pbr-sx-dnsmasq enable >/dev/null 2>&1 || true

/etc/init.d/keen-pbr-sx sync_firewall_hook >/dev/null 2>&1 || true

if [ "$PKG_UPGRADE" = "1" ] && /etc/init.d/keen-pbr-sx running >/dev/null 2>&1; then
    /etc/init.d/keen-pbr-sx restart || exit 1
fi

exit 0
